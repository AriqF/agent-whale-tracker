TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
HYPERTRACKER_API_KEY=your_hypertracker_key_here
9ROUTER_BASE_URL=https://your-9router-host/v1
9ROUTER_API_KEY=your_9router_api_key_here
LLM_MODEL=gpt-4o-mini

# Optional: comma-separated Telegram chat IDs (empty = open to all)
ALLOWED_CHAT_IDS=

# Optional: developer contact shown in whitelist denial message (e.g. @yourusername)
WHITELIST_DEV_CONTACT=

# Redis (chat context + monitor state)
REDIS_URL=redis://localhost:6379
CHAT_CONTEXT_TTL_HOURS=72

# BTC pulse monitor (proactive alerts to ALLOWED_CHAT_IDS)
MONITOR_ENABLED=false
MONITOR_COIN=BTC
MONITOR_INTERVAL_HOURS=4
MONITOR_BIAS_SHIFT_THRESHOLD=0.3
MONITOR_STARTUP_DELAY_MS=300000
